# MongoDB Atlas (required for persisted data)
MONGODB_URI=
# Default matches apps/web Mongo helper. Set to your existing DB name (e.g. it_advisory) if you are not migrating data.
MONGODB_DB_NAME=teqmd

# Optional pool tuning (Railway long-lived Node defaults shown in src/lib/mongodb.ts)
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_IDLE_TIME_MS=60000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Canonical public app URL for web and mobile wrappers.
# In production, set this to the hosted HTTPS domain that browsers and Capacitor apps should open.
# In local development, point it at the local Next.js server URL you actually use.
# Also used for absolute metadata and /api/admin/login redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public site / brand name (default until overridden in Admin → Settings → General).
SITE_NAME=TeqMD

# Google Analytics 4 (marketing site — loaded only after cookie consent for analytics)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional comma-separated extra public origins allowed when clients POST `appBaseUrl` for payment return URLs
# (native / split-domain). Each entry must be a full https:// or http:// origin or base URL. Example:
# CHECKOUT_ALLOWED_APP_BASE_URLS=https://www.example.com,https://example.com

# Optional public API origin override for wrappers or split-origin setups.
# Leave unset for normal same-origin web deploys on Railway.
# When set, client fetches and form posts use this hosted origin instead of relative `/api/*`.
# NEXT_PUBLIC_API_BASE_URL=https://your-app.up.railway.app

# Guided quiz intake (step 1): structured diagnostic rounds — requires OpenAI on cache miss
# OPENAI_API_KEY=
# OPENAI_DIAGNOSTIC_MODEL=gpt-4o-mini (use openai.chat — avoid Responses-only routing from openai())

# Diagnostic round cache (MongoDB): exact hash first, then Atlas Vector Search on `embedding` when configured.
# Bump DIAGNOSTIC_CACHE_VERSION after prompt or embedding-model changes.
# DIAGNOSTIC_CACHE_VERSION=1
# DIAGNOSTIC_CACHE_DISABLED=1
#
# Semantic similarity (requires Atlas Vector Search index on collection `diagnostic_round_cache`; same name as env).
# Embeddings use OPENAI_API_KEY (1536 dims default for text-embedding-3-small).
# DIAGNOSTIC_CACHE_VECTOR_INDEX_NAME=diagnostic_round_cache_vector
# DIAGNOSTIC_CACHE_VECTOR_MIN_SCORE=0.88
# DIAGNOSTIC_CACHE_VECTOR_NUM_CANDIDATES=200
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# DIAGNOSTIC_CACHE_SEMANTIC_DISABLED=1
#
# Diagnostic cache debug UI + `_diagnosticDebug` JSON are controlled from Admin → Settings (MongoDB `app_settings`).

# Required in production (min 16 chars): opaque diagnostic session refs in marketing URLs (`ds1.…`).
# DIAGNOSTIC_SESSION_URL_SECRET=

# Admin OAuth (Auth.js / NextAuth v5) — required in production for human /admin access.
# AUTH_SECRET=  # min 32 chars (session signing)
# ADMIN_ALLOWED_EMAILS=you@company.com,ops@company.com
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# Optional M2M Bearer for scripts (also reads legacy ADMIN_TOKEN):
# ADMIN_SERVICE_TOKEN=
# ALLOW_DEV_ADMIN_OPEN=1  # development only — bypass OAuth when no providers configured
# ADMIN_EMAIL_OTP_REQUIRED=1  # require a one-time email code after OAuth sign-in
ADMIN_TOKEN=

# Stronger model for /admin/advisor (separate from OPENAI_DIAGNOSTIC_MODEL).
# OPENAI_ADVISOR_MODEL=gpt-4.1

# Payment gateway credentials (encrypted at rest in MongoDB `payment_settings`).
# Required in production and before saving gateway API keys in Admin → Settings → Payments (min 32 characters).
# PAYMENT_CREDENTIALS_MASTER_KEY=

# Transactional email provider credentials (encrypted at rest in MongoDB `email_settings`).
# Required before saving API keys in Admin → Settings → Email (min 32 characters).
# If unset, legacy blobs encrypted only with PAYMENT_CREDENTIALS_MASTER_KEY can still be decrypted when that key is set.
# EMAIL_CREDENTIALS_MASTER_KEY=

# Optional fallback when Admin → Settings → Support notification emails are empty.
# SUPPORT_REPORT_TO=support@example.com

# Required in production (min 16 chars): signed tokens for /book/session links in confirmation emails.
# BOOKING_SESSION_ACCESS_SECRET=

# Required in production: protects POST /api/cron/payment-holds (expires pay-after-hold reservations).
# CRON_SECRET=

# Optional: extra browser/native origins allowed for support API CORS (comma-separated https origins).
# SUPPORT_CORS_EXTRA_ORIGINS=

# Optional: max OpenAI diagnostic API calls per IP per hour (default 30).
# RATE_LIMIT_DIAGNOSTIC_AI_PER_HOUR=30
# RATE_LIMIT_BOOKING_CREATE_PER_HOUR=10
# RATE_LIMIT_BOOKING_TOKEN_LOOKUP_PER_HOUR=30
# RATE_LIMIT_DIAGNOSTIC_SESSION_PER_HOUR=60

# Set to 1 to send enforcing Content-Security-Policy (default is report-only).
# CSP_ENFORCE=1

# Optional: include `details` on API 500 responses in production (default off).
# ALLOW_API_ERROR_DETAILS=1

# Video meeting provider credentials (encrypted at rest in MongoDB `meeting_settings`).
# Required before saving Zoom keys in Admin → Settings → Meetings (min 32 characters).
# MEETINGS_CREDENTIALS_MASTER_KEY=

# Optional: Zoom Server-to-Server OAuth via environment variables (fallback when Admin → Meetings is "None"
# or when admin Zoom credentials are incomplete). Prefer storing keys in Admin → Settings → Meetings.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=

# Optional: Google Meet via OAuth refresh token (fallback when Admin → Meetings selects Google Meet
# or when testing that provider). Prefer storing credentials in Admin → Settings → Meetings.
# GOOGLE_MEET_CLIENT_ID=
# GOOGLE_MEET_CLIENT_SECRET=
# GOOGLE_MEET_REFRESH_TOKEN=
# Optional calendar id (defaults to primary)
# GOOGLE_MEET_CALENDAR_ID=

# Optional: Microsoft Teams via Azure AD client credentials (fallback when Admin → Meetings selects Teams).
# MICROSOFT_TEAMS_TENANT_ID=
# MICROSOFT_TEAMS_CLIENT_ID=
# MICROSOFT_TEAMS_CLIENT_SECRET=
# Organizer Azure AD object id or userPrincipalName (meetings are created for this user)
# MICROSOFT_TEAMS_ORGANIZER_USER_ID=

# Consultation recording / Fathom (encrypted at rest in MongoDB `recording_settings`).
# Uses the same MEETINGS_CREDENTIALS_MASTER_KEY as video meeting credentials.
# Prefer Admin → Settings → Recordings; env vars are optional local fallbacks:
# FATHOM_API_KEY=
# FATHOM_WEBHOOK_SECRET=
# FATHOM_HOST_EMAIL=
# FATHOM_MATCH_WINDOW_MINUTES=15
# FATHOM_ENABLED=1

# Optional: CMS blog post embed ids for legal pages (MongoDB ObjectId from Admin → Blog → Embed id).
# When unset, built-in privacy policy and terms of use copy is shown instead.
# Posts must be published. Used on /privacy-policy, /terms-of-use, and login/register.
# Optional explicit ids; when unset, published posts with slug `privacy-policy` or `terms-of-use` are used.
# PRIVACY_POLICY_BLOG_POST_ID=
# TERMS_OF_USE_BLOG_POST_ID=
